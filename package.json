{
  "name": "@yoms/create-monorepo",
  "version": "1.1.0",
  "description": "CLI tool to scaffold monorepo projects from templates",
  "type": "module",
  "bin": {
    "create-monorepo": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test:generate": "tsx scripts/test-generate.ts",
    "test:validate": "tsx scripts/validate-templates.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepublishOnly": "pnpm build && pnpm typecheck"
  },
  "keywords": [
    "monorepo",
    "template",
    "scaffold",
    "cli",
    "pnpm",
    "workspace",
    "typescript",
    "hono",
    "nextjs",
    "prisma",
    "generator",
    "boilerplate",
    "starter"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yoms07/monorepo-template.git"
  },
  "bugs": {
    "url": "https://github.com/yoms07/monorepo-template/issues"
  },
  "homepage": "https://github.com/yoms07/monorepo-template#readme",
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "cac": "^6.7.14",
    "chalk": "^5.3.0",
    "enquirer": "^2.4.1",
    "execa": "^9.5.2",
    "fs-extra": "^11.2.0",
    "ora": "^8.1.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.5",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
